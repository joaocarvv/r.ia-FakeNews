rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Se já há regras no Firebase, inclua este match sem substituir
    // permissões previamente existentes de outras coleções.
    match /users/{userId}/analyses/{analysisId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validRecord() {
        let d = request.resource.data;
        return d.keys().hasAll(['analysisId', 'title', 'source', 'publishedDate', 'overallVerdict', 'healthArea', 'savedAt'])
          && d.keys().hasOnly(['analysisId', 'title', 'source', 'publishedDate', 'overallVerdict', 'healthArea', 'savedAt'])
          && d.analysisId is string && d.analysisId == analysisId && d.analysisId.size() <= 128
          && d.title is string && d.title.size() <= 256
          && d.source is string && d.source.size() <= 512
          && d.publishedDate is string && d.publishedDate.size() <= 80
          && d.healthArea is string && d.healthArea.size() <= 80
          && d.overallVerdict in ['verified', 'fake', 'uncertain']
          && d.savedAt is int && d.savedAt > 0;
      }
      allow get, list: if owner();
      allow create, update: if owner() && validRecord();
      allow delete: if owner();
    }
  }
}
