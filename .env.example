# Somente fontes reais. Se uma API estiver indisponível, o pipeline registra a falha.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
NCBI_API_KEY=
NCBI_EMAIL=
MAX_SOURCES=8
CHUNK_WORDS=60
CHUNK_OVERLAP=12
TOP_K=6
HTTP_TIMEOUT=20
LLM_TIMEOUT=120
# URLs públicas opcionais, separadas por vírgula. Não há scraping de resultados de busca.
WEB_URLS=
