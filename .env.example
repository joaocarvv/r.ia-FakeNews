# Somente fontes reais. Se uma API estiver indisponível, o pipeline registra a falha.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-ROMANCE-en
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
# Compatibilidade com configurações anteriores; o MVP não faz avaliação metodológica.
ASSESS_METHODOLOGY=false
NCBI_API_KEY=
NCBI_EMAIL=
MAX_SOURCES=8
CHUNK_WORDS=60
CHUNK_OVERLAP=12
TOP_K=6
HTTP_TIMEOUT=20
STRUCTURED_SEARCH_CACHE_TTL=300
LLM_TIMEOUT=120
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF=1
DOCUMENT_MAX_PAGES=100
DOCUMENT_PARSE_TIMEOUT=45
# Observabilidade local. Troque a senha antes de compartilhar a porta do Grafana.
LOG_LEVEL=INFO
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Verificação automática de novos estudos nas análises acompanhadas (0 desativa).
WATCH_INTERVAL_HOURS=24
# Preço usado na estimativa exibida antes da busca (US$ por milhão de tokens).
GEMINI_INPUT_PRICE_PER_MILLION_USD=0.10
GEMINI_OUTPUT_PRICE_PER_MILLION_USD=0.40

# Backend vetorial opcional; o padrão da web continua BM25.
VECTOR_STORE_BACKEND=memory
HYBRID_RETRIEVAL_ENABLED=false
VECTOR_TOP_K=8
VECTOR_MIN_SCORE=0.0
# error reporta falhas; bm25 autoriza retorno explícito e identificado ao BM25.
VECTOR_STORE_FAILURE_MODE=error
# Modo local para um processo; QDRANT_URL seleciona o servidor.
QDRANT_PATH=data/qdrant
QDRANT_URL=
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=fatofake_chunks
QDRANT_TIMEOUT=20
# Alterar ao trocar a revisão dos pesos do modelo.
EMBEDDING_REVISION=v1

# Comparação de títulos; não altera seleção nem resposta.
MEDCPT_SHADOW_ENABLED=false
MEDCPT_SHADOW_TOP_N=50
# Para experimentar o dual encoder, use EMBEDDING_MODEL=ncbi/MedCPT.

# BERTopic agrupa os títulos da página de resultados do PubMed.
BERTOPIC_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
