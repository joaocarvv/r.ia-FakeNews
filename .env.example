# Somente fontes reais. Se uma API estiver indisponível, o pipeline registra a falha.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-ROMANCE-en
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
NCBI_API_KEY=
NCBI_EMAIL=
# Chave gratuita recomendada para limites estáveis na API OpenAlex.
OPENALEX_API_KEY=
# Opcionais para testar plataformas editoriais no notebook 21.
SPRINGER_OPENACCESS_API_KEY=
SPRINGER_META_API_KEY=
ELSEVIER_API_KEY=
MAX_SOURCES=8
CHUNK_WORDS=60
CHUNK_OVERLAP=12
TOP_K=6
HTTP_TIMEOUT=20
LLM_TIMEOUT=120
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF=1
DOCUMENT_MAX_PAGES=100
DOCUMENT_PARSE_TIMEOUT=45
# Observabilidade local. Troque a senha antes de compartilhar a porta do Grafana.
LOG_LEVEL=INFO
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# URLs públicas opcionais, separadas por vírgula. Não há scraping de resultados de busca.
WEB_URLS=
# Texto integral: e-mail para a API do Unpaywall (usa NCBI_EMAIL se vazio).
UNPAYWALL_EMAIL=viniciuscesar.sena@gmail.com
# Navegador headless (Crawl4AI) para páginas abertas que dependem de JavaScript.
ENABLE_CRAWL4AI=true
CRAWL4AI_TIMEOUT=45
# Verificação automática de novos estudos nas análises acompanhadas (0 desativa).
WATCH_INTERVAL_HOURS=24
# Preço usado na estimativa exibida antes da busca (US$ por milhão de tokens).
GEMINI_INPUT_PRICE_PER_MILLION_USD=0.10
GEMINI_OUTPUT_PRICE_PER_MILLION_USD=0.40
# Opcional: agregador de repositórios institucionais (chave gratuita em core.ac.uk).
CORE_API_KEY=
