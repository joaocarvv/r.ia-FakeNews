TRANSLATION_MODEL=Helsinki-NLP/opus-mt-ROMANCE-en
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
NCBI_API_KEY=
NCBI_EMAIL=
# Chave gratuita recomendada para limites estáveis na API OpenAlex.
OPENALEX_API_KEY=
# Opcionais para testar plataformas editoriais no notebook 21.
SPRINGER_OPENACCESS_API_KEY=
SPRINGER_META_API_KEY=
ELSEVIER_API_KEY=
MAX_SOURCES=8
CHUNK_WORDS=60
CHUNK_OVERLAP=12
TOP_K=6
HTTP_TIMEOUT=20
LLM_TIMEOUT=120
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF=1
DOCUMENT_MAX_PAGES=100
DOCUMENT_PARSE_TIMEOUT=45
# URLs públicas opcionais, separadas por vírgula. Não há scraping de resultados de busca.
WEB_URLS=
